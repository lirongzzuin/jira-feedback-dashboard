# GAS Web App URL — deploy src/SetupUI.gs:doGet as a web app and paste the /exec URL here.
GAS_WEBAPP_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXXXXX/exec

# Optional: shared secret appended as ?token=... when calling GAS (keep in sync with GAS side).
# GAS_SHARED_TOKEN=

# Optional: 헤더/푸터의 사내 링크. 비워 두면 링크가 숨겨진다.
NEXT_PUBLIC_JIRA_BACKLOG_URL=
NEXT_PUBLIC_CONFLUENCE_URL=

# Optional: 대상 제품/프로젝트 이름 (화면 제목, Jira 태그 안내에 사용). 비워 두면 일반 명칭으로 표시.
NEXT_PUBLIC_PRODUCT_NAME=
